<?xml version="1.0" encoding="UTF-8"?>
<ruleset>
    <description>PHP_CodeSniffer configuration for yii2-apples</description>
    <date>2026-05-30</date>
    <name>yii2-apples</name>
    <file>common</file>
    <file>console</file>
    <file>backend</file>
    <file>frontend</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/runtime/*</exclude-pattern>
    <exclude-pattern>*/web/*</exclude-pattern>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="true"/>
    <arg name="colors"/>
    <rule ref="PSR2">
        <exclude>
            <property name="yii2" value="true"/>
        </exclude>
    </rule>
    <rule ref="Generic.Arrays.DollarArrayPunctuation">
        <exclude-pattern>*[a-zA-Z0-9]+</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard">
        <exclude-pattern>*/vendor/*</exclude-pattern>
    </rule>
</ruleset>
